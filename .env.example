# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# --- PostgreSQL (docker compose service) ---
POSTGRES_DB=finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- API ---
# Inside docker compose the host is "db"; for running the API on the host use localhost.
DATABASE_URL=postgresql+asyncpg://finpilot:change-me-local-only@localhost:5432/finpilot
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_MINUTES=60
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Cookies are only marked Secure when served over HTTPS
COOKIE_SECURE=false
IMPORT_MAX_BYTES=26214400

# Demo users created by the seed command (local/demo environments only)
DEMO_ADMIN_EMAIL=admin@finpilot.local
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_VIEWER_EMAIL=viewer@finpilot.local
DEMO_VIEWER_PASSWORD=Viewer@12345
