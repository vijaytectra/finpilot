# FinPilot local configuration.  cp .env.example .env
# .env is git-ignored. The values below are for a LOCAL, single-machine demo only; every
# shared/production deployment must inject real secrets (secrets manager / CI secrets).
# With ENVIRONMENT=production the API refuses to start with the default JWT secret.

# --- PostgreSQL (docker compose "db" service) ---
POSTGRES_DB=finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot-local-dev-password
# Host port. 5433 avoids clashing with a PostgreSQL already installed on 5432.
POSTGRES_PORT=5433

# --- API ---
# Used when the API runs on the host (uv run ...). docker compose overrides it to host "db".
DATABASE_URL=postgresql+asyncpg://finpilot:finpilot-local-dev-password@localhost:5433/finpilot
# >= 32 chars. Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-only-jwt-secret-do-not-use-in-any-shared-environment
JWT_EXPIRES_MINUTES=60
# local | test | ci | production   (production: JSON logs, no demo users, strict secrets)
ENVIRONMENT=local
LOG_LEVEL=INFO
# Only needed if a browser calls the API cross-origin; the web app proxies same-origin.
CORS_ORIGINS=http://localhost:3000
# Set true when served over HTTPS (e.g. the optional Caddy proxy profile)
COOKIE_SECURE=false
IMPORT_MAX_BYTES=26214400
API_PORT=8000
UVICORN_WORKERS=2
# Run the idempotent CSV/demo-user seed on every container start
SEED_ON_START=true

# --- Web ---
WEB_PORT=3000
PROXY_TLS_PORT=8443

# --- Demo users (created by the seed when ENVIRONMENT != production) ---
DEMO_ADMIN_EMAIL=admin@finpilot.local
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_VIEWER_EMAIL=viewer@finpilot.local
DEMO_VIEWER_PASSWORD=Viewer@12345
